<UserControl x:Class="MediaTracker.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MediaTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FF4F4A45">
        <TextBlock HorizontalAlignment="Left" Margin="32,26,0,0" TextWrapping="Wrap" Text="Главная" VerticalAlignment="Top" FontSize="35" Height="49" Width="172" Foreground="#FFDAC3B3" FontFamily="Cascadia Code"/>
        <Grid HorizontalAlignment="Left" Height="116" Margin="0,109,0,0" VerticalAlignment="Top" Width="271">
            <Border BorderBrush="Black" BorderThickness="0" CornerRadius="10,10,10,10" Background="#FFDAC3B3" Grid.ColumnSpan="2" Margin="30,0,0,0">
                <Grid Margin="10,0,0,10">
                    <TextBlock Name = "All"  HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="60" VerticalAlignment="Top" Height="64" Width="106"/>
                    <TextBlock HorizontalAlignment="Left" Margin="0,81,0,0" TextWrapping="Wrap" Text="Работ в коллекции" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="20" VerticalAlignment="Top" Height="25" Width="211"/>
                </Grid>
            </Border>
        </Grid>
        <Grid HorizontalAlignment="Left" Height="115" Margin="276,110,0,0" VerticalAlignment="Top" Width="271">
            <Border BorderBrush="Black" BorderThickness="0" CornerRadius="10,10,10,10" Background="#FFDAC3B3" Grid.ColumnSpan="2" Margin="30,0,0,0">
                <Grid Margin="10,0,0,10">
                    <TextBlock Name = "Seen"  HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="60" VerticalAlignment="Top" Height="64" Width="106"/>
                    <TextBlock HorizontalAlignment="Left" Margin="0,81,0,0" TextWrapping="Wrap" Text="Просмотрено" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="20" VerticalAlignment="Top" Height="25" Width="211"/>

                </Grid>
            </Border>
        </Grid>
        <Grid HorizontalAlignment="Left" Height="114" Margin="0,263,0,0" VerticalAlignment="Top" Width="271">
            <Border BorderBrush="Black" BorderThickness="0" CornerRadius="10,10,10,10" Background="#FFDAC3B3" Margin="30,0,0,0">
                <Grid Margin="10,0,0,10">
                    <TextBlock Name = "InProcess"  HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="60" VerticalAlignment="Top" Height="64" Width="106"/>
                    <TextBlock HorizontalAlignment="Left" Margin="0,81,0,0" TextWrapping="Wrap" Text="В процессе" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="20" VerticalAlignment="Top" Height="25" Width="211"/>

                </Grid>
            </Border>
        </Grid>
        <Grid HorizontalAlignment="Left" Height="115" Margin="276,262,0,0" VerticalAlignment="Top" Width="271">
            <Border BorderBrush="Black" BorderThickness="0" CornerRadius="10,10,10,10" Background="#FFDAC3B3" Grid.ColumnSpan="2" Margin="30,0,0,0">
                <Grid Margin="10,0,0,10">
                    <TextBlock Name = "NotSeen"  HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="60" VerticalAlignment="Top" Height="64" Width="106"/>
                    <TextBlock HorizontalAlignment="Left" Margin="0,81,0,0" TextWrapping="Wrap" Text="Не просмотрено" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="20" VerticalAlignment="Top" Height="25" Width="211"/>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

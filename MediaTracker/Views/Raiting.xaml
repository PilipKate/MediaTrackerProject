<UserControl x:Class="MediaTracker.Views.Raiting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MediaTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="PlaceholderTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="2,0"/>

                                <TextBlock x:Name="PlaceholderText"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="Gray"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cascadia Code"/>
            <Setter Property="FontSize" Value="30"/>

            <Setter Property="Foreground" Value="#4F4A45"/>
            <Setter Property="Padding" Value="5, 0, 5, 0"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
            Background="{TemplateBinding Background}"
            CornerRadius="3"
            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
            VerticalAlignment="Center"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                 Value="True">

                                <Setter TargetName="ButtonBorder"
                    Property="Background"
                    Value="#FF6C5F5B"/>

                                <Setter Property="Foreground"
                    Value="#DAC3B3"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                 Value="True">

                                <Setter TargetName="ButtonBorder"
                    Property="Background"
                    Value="#DAC3B3"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
    </UserControl.Resources>

    <Grid Background="#FF4F4A45" Margin="0,0,0,-244">
        <TextBlock HorizontalAlignment="Left" Margin="10,13,0,0" TextWrapping="Wrap" Text="Добавить оценку" VerticalAlignment="Top" FontSize="35" Height="49" Width="463" Foreground="#FFDAC3B3" FontFamily="Cascadia Code"/>
        <Grid HorizontalAlignment="Left" Height="252" Margin="10,62,0,0" VerticalAlignment="Top" Width="434" Background="#FF4F4A45">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Black" BorderThickness="0" CornerRadius="10,10,10,10" Background="#FFCDAB81" Margin="0,0,-21,45" Grid.ColumnSpan="2">
                <Grid Margin="0,0,0,22">
                    <TextBlock HorizontalAlignment="Left" Margin="27,24,0,0" TextWrapping="Wrap" Text="Оцените произведение" VerticalAlignment="Top" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="30" Width="397"/>

                    <TextBox x:Name="TitleRaiting" Style="{StaticResource PlaceholderTextBox}" Tag="Название:" Margin="60,74,60,70" Background="#FFCDAB81" FontSize="20" FontFamily="Cascadia Code" Foreground="#FF4F4A45" BorderThickness="0,0,0,0" />
                    <TextBox x:Name="Rate" Style="{StaticResource PlaceholderTextBox}" Tag="Оценка от 0 до 10:" Margin="60,110,60,36" Background="#FFCDAB81" FontSize="20" FontFamily="Cascadia Code" Foreground="#FF4F4A45" BorderThickness="0,0,0,0" />

                    <Button x:Name ="Rate_Button" Style="{StaticResource MenuButton}" Content="Добавить оценку" HorizontalAlignment="Left" VerticalAlignment="Top" Height="43" Width="194" Click="Rate_Button_Click"  Background="#FFCDAB81" FontFamily="Cascadia Code" FontSize="20" BorderThickness="0,0,0,0" Margin="27,144,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock HorizontalAlignment="Left" Margin="10,282,0,0" TextWrapping="Wrap" Text="Изменить статус" VerticalAlignment="Top" FontSize="35" Height="49" Width="463" Foreground="#FFDAC3B3" FontFamily="Cascadia Code"/>
        <Grid HorizontalAlignment="Left" Height="219" Margin="10,384,0,0" VerticalAlignment="Top" Width="556" Background="#FF4F4A45">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Black" BorderThickness="0" CornerRadius="10,10,10,10" Background="#FFDAC3B3" Grid.ColumnSpan="2" Margin="0,-58,105,59">
                <Grid Margin="10,0,0,10">
                    <TextBlock HorizontalAlignment="Left" Margin="27,10,0,0" TextWrapping="Wrap" Text="Укажите статус" VerticalAlignment="Top" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="30" Width="396"/>
                    <TextBlock HorizontalAlignment="Left" Margin="68,103,0,0" TextWrapping="Wrap" Text="Статус:" VerticalAlignment="Top" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="20"/>

                    <TextBox x:Name="TitleStatus" Style="{StaticResource PlaceholderTextBox}" Tag="Название:" Margin="62,65,164,111" Background="#FFDAC3B3" FontSize="20" FontFamily="Cascadia Code" Foreground="#FF4F4A45" BorderThickness="0,0,0,0" />
                    <ComboBox x:Name="NewStatusList" Margin="68,131,196,0" Foreground="#FF4F4A45" Text="Статус" FontFamily="Cascadia Code" BorderBrush="#FFDAC3B3" ItemsSource="{Binding Statuses}" SelectedItem="{Binding NewSelectedStatus, Mode=TwoWay}" DisplayMemberPath="Name" VerticalAlignment="Top" Height="30">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#4F4A45"/>
                                <Setter Property="Foreground" Value="#DAC3B3"/>
                                <Setter Property="Padding" Value="8,5"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button x:Name ="Change_Status_Button" Style="{StaticResource MenuButton}" Content="Изменить" HorizontalAlignment="Left" VerticalAlignment="Top" Height="43" Width="111" Click="Change_Status_Button_Click"  Background="#FFDAC3B3" FontFamily="Cascadia Code" FontSize="20" BorderThickness="0,0,0,0" Margin="27,166,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

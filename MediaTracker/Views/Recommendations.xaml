<UserControl x:Class="MediaTracker.Views.Recommendations"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MediaTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cascadia Code"/>
            <Setter Property="FontSize" Value="30"/>

            <Setter Property="Foreground" Value="#4F4A45"/>
            <Setter Property="Padding" Value="5, 0, 5, 0"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">

                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background"  Value="#FF6C5F5B"/>

                                <Setter Property="Foreground" Value="#DAC3B3"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background"  Value="#DAC3B3"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
    </UserControl.Resources>
    <Grid Background="#FF4F4A45" Margin="0,0,0,-27">


        <Button x:Name ="Films_Button" Style="{StaticResource MenuButton}" Content="Фильмы" HorizontalAlignment="Left" VerticalAlignment="Top" Height="43" Width="102" Click="Films_Button_Click"  Background="#FFDAC3B3" FontFamily="Cascadia Code" FontSize="20" BorderThickness="0,0,0,0" Margin="308,26,0,0" RenderTransformOrigin="1.371,-2.172"/>
        <Button x:Name ="Serials_Button" Style="{StaticResource MenuButton}" Content="Сериалы" HorizontalAlignment="Left" VerticalAlignment="Top" Height="43" Width="107" Click="Serials_Button_Click"  Background="#FFDAC3B3" FontFamily="Cascadia Code" FontSize="20" BorderThickness="0,0,0,0" Margin="415,26,0,0" RenderTransformOrigin="1.371,-2.172"/>
        <Button x:Name ="Best_Button" Style="{StaticResource MenuButton}" Content="Лучшее" HorizontalAlignment="Left" VerticalAlignment="Top" Height="43" Width="101" Click="Best_Button_Click"  Background="#FFDAC3B3" FontFamily="Cascadia Code" FontSize="20" BorderThickness="0,0,0,0" Margin="527,26,0,0" RenderTransformOrigin="1.371,-2.172"/>
        <Grid HorizontalAlignment="Left" Height="95" Margin="10,80,0,0" VerticalAlignment="Top" Width="578" Background="#FF4F4A45">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Black" BorderThickness="0" CornerRadius="10,10,10,10" Background="#FFDAC3B3" Grid.ColumnSpan="2" Margin="0,0,-41,0">
                <Grid Margin="10,0,0,10">
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Свой фильтр" VerticalAlignment="Top" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="25" Width="198"/>
                    <TextBlock HorizontalAlignment="Left" Margin="224,45,0,0" TextWrapping="Wrap" Text="Жанр:" VerticalAlignment="Top" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="20" Width="80" Height="30" RenderTransformOrigin="0.119,0.883"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,45,0,0" TextWrapping="Wrap" Text="Тип:" VerticalAlignment="Top" Foreground="#FF4F4A45" FontFamily="Cascadia Code" FontSize="20" Width="52" Height="30" RenderTransformOrigin="0.625,0.55"/>
                    <Button x:Name ="You_Filter_Button" Style="{StaticResource MenuButton}" Content="Показать" HorizontalAlignment="Left" VerticalAlignment="Top" Height="37" Width="134" Click="You_Filter_Button_Click"  Background="#FFDAC3B3" FontFamily="Cascadia Code" FontSize="20" BorderThickness="0,0,0,0" Margin="461,39,0,0" RenderTransformOrigin="0.437,0.452"/>
                    <Button x:Name ="Add_Filter_Button" Style="{StaticResource MenuButton}" Content="Добавить свой фильтр" HorizontalAlignment="Left" VerticalAlignment="Top" Height="31" Width="276" Click="Add_Filter_Button_Click"  Background="#FFDAC3B3" FontFamily="Cascadia Code" FontSize="20" BorderThickness="0,0,0,0" Margin="323,8,0,0" RenderTransformOrigin="0.373,0.536"/>

                    <ComboBox x:Name="GanreFilterList" Margin="290,45,191,0" Foreground="#FF4F4A45" FontFamily="Cascadia Code" BorderBrush="#FFDAC3B3" ItemsSource="{Binding Ganres}" SelectedItem="{Binding SelectedGanreFilter, Mode=TwoWay}" DisplayMemberPath="Name" VerticalAlignment="Top" Height="30" Text="Жанр">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#4F4A45"/>
                                <Setter Property="Foreground" Value="#DAC3B3"/>
                                <Setter Property="Padding" Value="8,5"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <ComboBox x:Name="TypeFilterList" Margin="67,46,414,0" Foreground="#FF4F4A45" FontFamily="Cascadia Code" BorderBrush="#FFDAC3B3" ItemsSource="{Binding TypeFilter}" SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}" DisplayMemberPath="Name" VerticalAlignment="Top" Height="30" RenderTransformOrigin="0.198,0.965" >
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#4F4A45"/>
                                <Setter Property="Foreground" Value="#DAC3B3"/>
                                <Setter Property="Padding" Value="8,5"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>


                </Grid>
            </Border>
        </Grid>
        <TextBlock HorizontalAlignment="Left" Margin="10,26,0,0" TextWrapping="Wrap" Text="Рекомендации" VerticalAlignment="Top" FontSize="35" Height="49" Width="274" Foreground="#FFDAC3B3" FontFamily="Cascadia Code"/>
        <Grid Background="#4F4A45" Margin="10,180,10,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="166*"/>
                <ColumnDefinition Width="615*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2" Margin="0,0,-114,0">

                <ItemsControl ItemsSource="{Binding Recs}" Width="749">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <ContentControl Content="{Binding Work}" ContentTemplate="{Binding Template}" />

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>

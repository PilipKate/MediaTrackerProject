<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaTracker"
        xmlns:Views="clr-namespace:MediaTracker.Views" x:Class="MediaTracker.MainWindow"
        mc:Ignorable="d"
        Title="Главная" Height="600" Width="1025" Background="#FF4F4A45" Topmost="True" FontFamily="Cascadia Code" FontSize="20" Foreground="#FFDAC3B3" MaxWidth="1025" MaxHeight="600">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cascadia Code"/>
            <Setter Property="FontSize" Value="30"/>

            <Setter Property="Foreground" Value="#DAC3B3"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Height" Value="70"/>

            <Setter Property="Margin" Value="30, 0, 30, 0"/>

            <Setter Property="Padding" Value="15,0"/>

            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        VerticalAlignment="Center"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#CDAB81"/>

                                <Setter Property="Foreground"
                                Value="#4F4A45"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#DAC3B3"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="Black" Margin="10,8,667,7" Background="#FF6C5F5B" CornerRadius="10,10,10,10">
            <StackPanel Margin="1,23,1,1">
                <TextBlock TextWrapping="Wrap" Text="МЕНЮ" Foreground="#FFDAC3B3" FontSize="48" FontFamily="Cascadia Code" Height="69" Width="131" Margin="40,0,0,0" HorizontalAlignment="Left"/>
                <Separator Background="#FFDAC3B3" Margin="0,-7,0,2" MinWidth="0" MinHeight="11" Height="35" Width="265" />
                <Button x:Name="Main_Button" Content="Главная" Click="Main_Button_Click" Style="{StaticResource MenuButton}"/>
                <Button x:Name ="Catalog_Button" Content="Каталог" Click="Catalog_Button_Click" Style="{StaticResource MenuButton}"/>
                <Button x:Name ="Recommend_Button" Content="Рекомендации" Click="Recommend_Button_Click" Style="{StaticResource MenuButton}"/>
                <Button x:Name ="Raiting_Button" Content="Оценки" Click="Raiting_Button_Click" Style="{StaticResource MenuButton}"/>
                <Button x:Name ="Add_Menu_Button" Content="Добавить" Click="Add_Menu_Button_Click" Style="{StaticResource MenuButton}"/>
                <Button x:Name ="Delete_Menu_Button" Content="Удалить" Click="Delete_Menu_Button_Click" Style="{StaticResource MenuButton}"/>

            </StackPanel>
        </Border>
        <Grid Margin="355,10,0,10" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="625*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="MainContent" Margin="0,0,10,0" Grid.ColumnSpan="2"></ContentControl>
        </Grid>
    </Grid>


</Window>
